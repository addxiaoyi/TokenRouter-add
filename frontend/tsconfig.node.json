{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.cache/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "vite.config.ts",
    "socialMetadata.ts",
    "src/i18n/locales/en/seo.ts",
    "src/i18n/locales/zh/seo.ts"
  ]
}
